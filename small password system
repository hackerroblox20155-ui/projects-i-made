public static bool GetPass(int[] arr, int password)
{
    for (int i = 0; i < arr.Length; i++)
    {
        if (arr[i] == password)
        {
            return false;
        }
    }

    for (int i = arr.Length - 1; i > 0; i--)
    {
        arr[i] = arr[i - 1];
    }

    arr[0] = password;
    return true;
}
